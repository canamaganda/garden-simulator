        .tr-node { background:linear-gradient(145deg,#DDEAF2,#F7F9FA) !important; border-color:#A7B9C4 !important; color:#40515C !important; box-shadow:0 5px 0 #C5D4DC,0 8px 14px rgba(64,81,92,.12) !important; }
        .tr-node.visited { background:linear-gradient(145deg,#BDD5E3,#DDEAF2) !important; border-color:#789DB5 !important; box-shadow:0 5px 0 #607D94,0 10px 18px rgba(80,110,125,.16) !important; }
        .tr-seq { background:#F7F9FA !important; border-color:#A7B9C4 !important; color:#40515C !important; }
        .tr-seq strong { color:#607D94 !important; }
        .tr-help { color:#718590 !important; }
        header { border-color:#A7B9C4 !important; }
        button { color:#40515C; }
        input,textarea,select { background:#FFFFFF !important; color:#344A57 !important; border-color:#A7B9C4 !important; }
        ::placeholder { color:#8E9BA3 !important; }
    
/* =========================================================
   GARDEN UI THEME — DEEP GREEN + EARTH BROWN + POPPING BLUE
   ========================================================= */

