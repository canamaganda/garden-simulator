    </main>

    <script>
        let pyodideInstance = null;
        let savedCode = JSON.parse(localStorage.getItem("savedDSACode")) || {};
        let actionStack = [];
        
        // Game State Variables
        let userCoins = 200;
        let waterReserves = 500;
        let maxWater = 500;
        let solarEnergy = 100;
        let maxEnergy = 100;
        let hopeLevel = 100;
        let maxHope = 100;
        let cactusAmmo = 100;
        let zombieCount = 0;
        let gardenGridState = Array(25).fill(null);

        const seedDatabase = {
            "Tulip": { emoji: "🌷", cost: 20 },
            "Cherry Blossom": { emoji: "🌸", cost: 35 },
            "Sunflower": { emoji: "🌻", cost: 15 },
            "Tomato": { emoji: "🍅", cost: 25 },
            "Onion": { emoji: "🧅", cost: 15 },
            "Eggplant": { emoji: "🍆", cost: 30 },
            "Strawberry": { emoji: "🍓", cost: 30 },
            "Watermelon": { emoji: "🍉", cost: 50 },
            "Mango": { emoji: "🥭", cost: 45 }
        };

        async function initPyodide() {
            if (!pyodideInstance) {
                pyodideInstance = await loadPyodide();
                pyodideInstance.globals.set("unlockFeature", unlockFeature);
                pyodideInstance.globals.set("updateResources", updateResources);
                pyodideInstance.globals.set("addPlantsToDropdown", addPlantsToDropdown);
                pyodideInstance.globals.set("pushAction", pushAction);
                pyodideInstance.globals.set("updateClimateQueue", updateClimateQueue);
                await pyodideInstance.runPythonAsync(`
                    import sys
                    from js import document
                    class Console:
                        def write(self, text):
                            if text and text.strip():
                                el = document.getElementById("output-console")
                                if el:
                                    el.innerHTML += text.replace("\\n", "<br>")
                        def flush(self): pass
                    sys.stdout = Console()
                `);
            }
        }

        function unlockFeature(feature) {
            if (feature === "resources") {
                document.getElementById("resources-section").classList.remove("locked");
                document.getElementById("resources-section").classList.add("unlocked");
            }
            if (feature === "stack") {
                document.getElementById("stack-panel").classList.remove("locked");
                document.getElementById("stack-panel").classList.add("unlocked");
            }
            if (feature === "queue") {
                document.getElementById("climate-queue-panel").classList.remove("locked");
                document.getElementById("climate-queue-panel").classList.add("unlocked");
            }
            if (feature === "grid") {
                document.getElementById("view-game").classList.remove("locked");
                document.getElementById("view-game").classList.add("unlocked");
            }
        }

        function updateClimateQueue(events) {
            const container = document.getElementById("climate-queue");
            container.innerHTML = "";
            events.forEach(event => {
                const div = document.createElement("div");
                div.className = "p-2 bg-[#1A100C] border border-amber-900 rounded-lg text-xs";
                div.innerHTML = `<div class="font-bold text-amber-400">${event}</div>`;
                container.appendChild(div);
            });
        }

        function updateResources(water=waterReserves, seeds=90, energy=solarEnergy, hope=hopeLevel, coins=userCoins) {
            if (typeof water === 'object' && water !== null) {
                const args = water;
                water = args.water !== undefined ? args.water : waterReserves;
                coins = args.coins !== undefined ? args.coins : userCoins;
                energy = args.energy !== undefined ? args.energy : solarEnergy;
                hope = args.hope !== undefined ? args.hope : hopeLevel;
            }
            
            waterReserves = water;
            userCoins = coins;
            solarEnergy = energy;
            hopeLevel = hope;

            document.getElementById("water-text").innerText = `${waterReserves} / ${maxWater} L`;
            document.getElementById("water-bar").style.width = `${(waterReserves / maxWater) * 100}%`;
            document.getElementById("energy-text").innerText = `${solarEnergy} / ${maxEnergy} Wh`;
            document.getElementById("energy-bar").style.width = `${(solarEnergy / maxEnergy) * 100}%`;
            document.getElementById("hope-text").innerText = `${hopeLevel} / ${maxHope}`;
            document.getElementById("hope-bar").style.width = `${(hopeLevel / maxHope) * 100}%`;
            document.getElementById("coins-text").innerText = `${userCoins} Coins`;
            document.getElementById("cactus-counter").innerText = `${cactusAmmo} / 100`;
        }

        function addPlantsToDropdown(plants) {
            const select = document.getElementById("crop-selector");
            select.innerHTML = "";
            plants.forEach(([name, emoji, cost]) => {
                const option = document.createElement("option");
                option.value = name;
                option.textContent = `${emoji} ${name} (${cost}c)`;
                select.appendChild(option);
            });
        }

        function buyWaterRefill() {
            const WATER_COST = 15;
            const WATER_AMOUNT = 100;

            if (waterReserves >= maxWater) {
                showToast("💧 Your water reserves are already full!");
                return;
            }

            if (userCoins < WATER_COST) {
                showToast("❌ Not enough coins to buy water!");
                return;
            }

            userCoins -= WATER_COST;
            waterReserves = Math.min(maxWater, waterReserves + WATER_AMOUNT);
            updateResources(waterReserves, 90, solarEnergy, hopeLevel, userCoins);

            pushAction(`Bought +100L Water (-${WATER_COST}c)`);
            showToast(`🪣 Bought +100L Water for 15 Coins!`);
        }

        // PLANTING LOGIC
        function plantSeedInPlot(index) {
            const selectedPlantName = document.getElementById("crop-selector").value;
            if (!selectedPlantName) {
                showToast("Please unlock/select a seed from your bag first!");
                return;
            }

            const plantData = seedDatabase[selectedPlantName] || { emoji: "🌱", cost: 20 };

            if (userCoins < plantData.cost) {
                showToast("❌ Not enough coins to buy this seed!");
                return;
            }

            userCoins -= plantData.cost;
            updateResources(waterReserves, 90, solarEnergy, hopeLevel, userCoins);

            updateGrowthProcess("plant", selectedPlantName);
            gardenGridState[index] = {
                name: selectedPlantName,
                cost: plantData.cost,
                emoji: plantData.emoji,
                stage: 0,
                isZombie: false,
                isDry: false,
                waterTimer: null,
                waterTimeLeft: 5,  // ⚡ UPDATED: 5s El Nino Timer
                zombieTimer: null,
                zombieTimeLeft: 10, // ⚡ UPDATED: 10s Harvest Timer
                shootTimer: null,
                shootTimeLeft: 10  // ⚡ UPDATED: 10s Shooting Timer
            };

            pushAction(`Bought & Planted ${selectedPlantName} (-${plantData.cost}c)`);
            startWaterTimer(index);
            renderGarden();
        }

        // ☀️ EL NIÑO WATER TIMER (5 Seconds)
        function startWaterTimer(index) {
            const tile = gardenGridState[index];
            if (!tile) return;

            tile.waterTimeLeft = 5; // 5 seconds
            if (tile.waterTimer) clearInterval(tile.waterTimer);

            tile.waterTimer = setInterval(() => {
                if (!gardenGridState[index] || gardenGridState[index] !== tile || tile.stage === 2 || tile.isZombie) {
                    clearInterval(tile.waterTimer);
                    return;
                }

                tile.waterTimeLeft--;
                renderGarden();

                if (tile.waterTimeLeft <= 0) {
                    clearInterval(tile.waterTimer);
                    triggerElNinoForTile(index);
                }
            }, 1000);
        }

        function triggerElNinoForTile(index) {
            const tile = gardenGridState[index];
            if (!tile) return;

            tile.isDry = true;
            showToast(`☀️ El Niño dried up your ${tile.name}!`);

            const banner = document.getElementById("weather-banner");
            document.getElementById("weather-icon").innerText = "☀️🔥";
            document.getElementById("weather-title").innerText = "El Niño Drought Hit!";
            document.getElementById("weather-desc").innerText = "Plant dried up! Unwatered for 5 seconds.";
            banner.className = "elnino-panel rounded-xl p-3 flex items-center justify-between text-white mb-4 shadow-md transition-all";

            renderGarden();

            setTimeout(() => {
                document.getElementById("weather-icon").innerText = "☀️";
                document.getElementById("weather-title").innerText = "Fast-Paced Gardening!";
                document.getElementById("weather-desc").innerText = "Water in 5s or El Niño strikes! Harvest/shoot in 10s!";
                banner.className = "sky-panel rounded-xl p-3 flex items-center justify-between text-gray-800 mb-4 shadow-md transition-all";
            }, 4000);
        }

        // WATERING & GROWTH
        function waterPlant(index) {
            const tile = gardenGridState[index];
            if (!tile || tile.isZombie || tile.isDry) return;

            if (waterReserves < 15) {
                showToast("❌ Water empty! Click 'Buy Water' in Storage.");
                return;
            }

            waterReserves -= 15;
            updateResources(waterReserves, 90, solarEnergy, hopeLevel, userCoins);

            updateGrowthProcess("water", tile.name);
            if (tile.stage < 2) {
                tile.stage++;
                pushAction(`Watered ${tile.name} (Stage ${tile.stage})`);

                if (tile.stage === 2) {
                    updateGrowthProcess("mature", tile.name);
                    if (tile.waterTimer) clearInterval(tile.waterTimer);
                    startHarvestZombieTimer(index);
                } else {
                    updateGrowthProcess("seedling", tile.name);
                    startWaterTimer(index); // Reset 5s timer for next growth stage
                }
            }
            renderGarden();
        }

        // HARVEST COUNTDOWN TO ZOMBIE (10 Seconds)
        function startHarvestZombieTimer(index) {
            const tile = gardenGridState[index];
            if (!tile) return;

            tile.zombieTimeLeft = 10; // 10 seconds
            tile.zombieTimer = setInterval(() => {
                if (!gardenGridState[index] || gardenGridState[index] !== tile || tile.isZombie) {
                    clearInterval(tile.zombieTimer);
                    return;
                }

                tile.zombieTimeLeft--;
                renderGarden();

                if (tile.zombieTimeLeft <= 0) {
                    clearInterval(tile.zombieTimer);
                    turnIntoZombie(index);
                }
            }, 1000);
        }

        // ZOMBIE CREATION & SHOOT TIMER (10 Seconds)
        function turnIntoZombie(index) {
            const tile = gardenGridState[index];
            if (!tile) return;

            tile.isZombie = true;
            tile.shootTimeLeft = 10; // 10s Shoot Window
            zombieCount++;
            document.getElementById("zombie-counter").innerText = `${zombieCount} / 3`;
            showToast(`🧟 Zombie ate your ${tile.name}! Shoot with 🌵 in 10s!`);

            renderGarden();

            if (zombieCount >= 3) {
                triggerTyphoonWipeout();
            } else {
                startZombieShootTimer(index);
            }
        }

        // ZOMBIE WANDER TIMER (If not shot in 10s)
        function startZombieShootTimer(index) {
    const tile = gardenGridState[index];
    if (!tile) return;

    tile.shootTimer = setInterval(() => {
        // Stop timer if the tile was already cleared/shot
        if (!gardenGridState[index] || gardenGridState[index] !== tile || !tile.isZombie) {
            clearInterval(tile.shootTimer);
            return;
        }

        tile.shootTimeLeft--;
        renderGarden();

        if (tile.shootTimeLeft <= 0) {
            clearInterval(tile.shootTimer);
            tile.shootTimer = null;
            zombieWanderAndEat(index); // Trigger expiration
        }
    }, 1000);
}

function zombieWanderAndEat(fromIndex) {
    const oldTile = gardenGridState[fromIndex];
    
    // Clear interval safeguard
    if (oldTile && oldTile.shootTimer) {
        clearInterval(oldTile.shootTimer);
    }

    // REMOVE THE OLD ZOMBIE IMMEDIATELY FROM THE GRID
    gardenGridState[fromIndex] = null; 
    zombieCount = Math.max(0, zombieCount - 1);
    
    // REDUCE HOPE (-15)
    hopeLevel = Math.max(0, hopeLevel - 15);
    updateResources(waterReserves, 90, solarEnergy, hopeLevel, userCoins);

    // Find all living plants remaining on the grid
    const livingIndices = [];
    gardenGridState.forEach((t, i) => {
        if (t && !t.isZombie && !t.isDry) livingIndices.push(i);
    });

    if (livingIndices.length > 0) {
        // Pick a random remaining plant, eat it, and spawn a new zombie there
        const targetIndex = livingIndices[Math.floor(Math.random() * livingIndices.length)];
        showToast(`🧟 Zombie escaped, ate a plant at plot #${targetIndex + 1}, and damaged Hope (-15)!`);
        turnIntoZombie(targetIndex);
    } else {
        // If no plants are left, zombie just disappears completely
        showToast(`🧟 Zombie vanished, but damaged your Hope (-15)!`);
    }

    renderGarden();
}

        // 🌵 SHOOT ZOMBIE WITH CACTUS (10c)
        function shootZombie(index) {
            const tile = gardenGridState[index];
            if (!tile || !tile.isZombie) return;

            if (cactusAmmo <= 0) {
                showToast("❌ Out of Cactus Ammo!");
                return;
            }

            if (userCoins < 10) {
                showToast("❌ Shooting costs 10 Coins!");
                return;
            }

            userCoins -= 10;
            cactusAmmo -= 1;
            zombieCount = Math.max(0, zombieCount - 1);
            updateResources(waterReserves, 90, solarEnergy, hopeLevel, userCoins);

            if (tile.shootTimer) clearInterval(tile.shootTimer);
            gardenGridState[index] = null;

            pushAction(`Shot Zombie at Plot #${index + 1} (-10c, -1🌵)`);
            showToast(`🌵 Shot and killed zombie at plot #${index + 1}!`);

            renderGarden();
        }

        function harvestPlant(index) {
            const tile = gardenGridState[index];
            if (!tile || tile.stage < 2 || tile.isZombie || tile.isDry) return;

            if (tile.zombieTimer) clearInterval(tile.zombieTimer);

            const earned = tile.cost * 2;
            userCoins += earned;
            updateResources(waterReserves, 90, solarEnergy, hopeLevel, userCoins);

            pushAction(`Harvested ${tile.name} (+${earned}c)`);
            updateGrowthProcess("harvest", tile.name);
            showToast(`🌾 Harvested ${tile.name} for +${earned} Coins!`);

            gardenGridState[index] = null;
            renderGarden();
        }

        // 🌧️ TYPHOON WIPEOUT (3 Zombies)
        function triggerTyphoonWipeout() {
            const banner = document.getElementById("weather-banner");
            document.getElementById("weather-icon").innerText = "🌧️⚡";
            document.getElementById("weather-title").innerText = "Typhoon Disaster Wipeout!";
            document.getElementById("weather-desc").innerText = "3 Zombies overran the garden! Typhoon wiped out all crops!";
            banner.className = "rain-panel rounded-xl p-3 flex items-center justify-between text-white mb-4 shadow-md transition-all";

            gardenGridState.forEach((tile, i) => {
                if (tile) {
                    if (tile.waterTimer) clearInterval(tile.waterTimer);
                    if (tile.zombieTimer) clearInterval(tile.zombieTimer);
                    if (tile.shootTimer) clearInterval(tile.shootTimer);
                }
                gardenGridState[i] = null;
            });

            zombieCount = 0;
            document.getElementById("zombie-counter").innerText = `0 / 3`;

            showToast("🌩️ Typhoon wiped out your garden!");
            renderGarden();

            setTimeout(() => {
                document.getElementById("weather-icon").innerText = "☀️";
                document.getElementById("weather-title").innerText = "Fast-Paced Gardening!";
                document.getElementById("weather-desc").innerText = "Water in 5s or El Niño strikes! Harvest/shoot in 10s!";
                banner.className = "sky-panel rounded-xl p-3 flex items-center justify-between text-gray-800 mb-4 shadow-md transition-all";
            }, 6000);
        }

        function renderGarden() {
            const grid = document.getElementById("garden-grid");
            grid.innerHTML = "";

            for (let i = 0; i < 25; i++) {
                const tile = gardenGridState[i];
                const cell = document.createElement("div");
                cell.className = "aspect-square bg-[#36241C] rounded-xl flex flex-col items-center justify-between p-1 border border-[#5D4037] relative shadow-inner overflow-hidden";

                if (!tile) {
                    cell.innerHTML = `
                        <div class="flex-1 flex items-center justify-center text-2xl cursor-pointer hover:scale-110 transition-transform" onclick="plantSeedInPlot(${i})">🟫</div>
                        <span class="text-[9px] text-amber-400/60 font-semibold">Plant</span>
                    `;
                } else if (tile.isZombie) {
                    cell.innerHTML = `
                        <div class="text-xl animate-bounce mt-1">🧟</div>
                        <div class="text-[9px] text-red-400 font-mono font-bold">${tile.shootTimeLeft}s</div>
                        <button onclick="shootZombie(${i})" class="w-full bg-red-800 hover:bg-red-700 text-white text-[9px] font-bold py-0.5 rounded border border-red-500 flex items-center justify-center gap-0.5 mt-0.5">
                            🌵 Shoot (10c)
                        </button>
                    `;
                } else if (tile.isDry) {
                    cell.innerHTML = `
                        <div class="flex-1 flex items-center justify-center text-2xl">🍂</div>
                        <button onclick="gardenGridState[${i}]=null; renderGarden();" class="w-full bg-amber-900 hover:bg-amber-800 text-amber-200 text-[9px] font-bold py-0.5 rounded">
                            🗑️ Clear
                        </button>
                    `;
                } else {
                    let displayEmoji = "🌱";
                    if (tile.stage === 1) displayEmoji = "🌿";
                    if (tile.stage === 2) displayEmoji = tile.emoji;

                    cell.innerHTML = `
                        <div class="text-xl mt-1">${displayEmoji}</div>
                        <div class="text-[9px] text-amber-300 font-mono font-bold">
                            ${tile.stage < 2 ? `💧${tile.waterTimeLeft}s` : `⏳${tile.zombieTimeLeft}s`}
                        </div>
                        <div class="w-full mt-1">
                            ${tile.stage < 2 ? `
                                <button onclick="waterPlant(${i})" class="w-full bg-cyan-800 hover:bg-cyan-700 text-cyan-100 text-[9px] font-bold py-0.5 rounded flex items-center justify-center gap-0.5">
                                    🪣 Water
                                </button>
                            ` : `
                                <button onclick="harvestPlant(${i})" class="w-full bg-emerald-700 hover:bg-emerald-600 text-emerald-100 text-[9px] font-bold py-0.5 rounded flex items-center justify-center gap-0.5">
                                    🌾 Harvest
                                </button>
                            `}
                        </div>
                    `;
                }
                grid.appendChild(cell);
            }
        }

        function pushAction(action) {
            actionStack.push(action);
            if (actionStack.length > 8) actionStack.shift();
            renderActionStack();
        }

        function renderActionStack() {
            const container = document.getElementById("action-stack");
            container.innerHTML = "";
            [...actionStack].reverse().forEach(act => {
                const div = document.createElement("div");
                div.className = "bg-[#1A100C] border-l-2 border-amber-500 px-2.5 py-1.5 rounded text-[11px] text-amber-200";
                div.textContent = `→ ${act}`;
                container.appendChild(div);
            });
        }

        function triggerUndo() {
            if (actionStack.length > 0) {
                const undone = actionStack.pop();
                renderActionStack();
                showToast(`Undid: ${undone}`);
            } else {
                showToast("Action stack is empty.");
            }
        }

        function renderClimateQueue() {
            const container = document.getElementById("climate-queue");
            container.innerHTML = `
                <div class="p-2.5 bg-[#1A100C] border border-amber-900 rounded-xl text-xs">
                    <div class="font-bold text-amber-400">El Niño & Typhoon Risks</div>
                    <div class="text-amber-300/70 text-[10px]">Active FIFO Weather Warnings</div>
                </div>
            `;
        }

        function showToast(msg) {
            const toast = document.createElement("div");
            toast.className = "fixed bottom-6 right-6 bg-amber-900 border border-amber-500 text-amber-100 px-4 py-2.5 rounded-xl shadow-2xl z-50 text-xs font-semibold";
            toast.textContent = msg;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2500);
        }

        async function runPythonCode() {
            await initPyodide();
            const code = document.getElementById("code-editor").value.trim();
            const key = parseInt(document.getElementById("topic-selector").value);
            const consoleEl = document.getElementById("output-console");
      
            consoleEl.innerHTML = `<span class="text-amber-400">Running Python script...</span><br>`;
      
            try {
                await pyodideInstance.runPythonAsync(code);
           
                if (key === 1 && code.includes("addPlantsToDropdown")) {
                    unlockFeature("resources");
                    pushAction("Resources & Seed Bag Initialized");
                }
                if (key === 2 && code.includes("ActionHistoryStack")) {
                    unlockFeature("stack");
                }
                if (key === 3 && code.includes("ClimateQueue")) {
                    unlockFeature("queue");
                }
                if (key === 4) {
                    unlockFeature("grid");
                }
            } catch (err) {
                consoleEl.innerHTML += `<span class="text-red-400">Error: ${err.message}</span>`;
            }
        }

        const topicTemplates = {
