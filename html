<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Python-Based Garden Simulator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/pyodide/v0.26.1/full/pyodide.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F5F7F8;
            background-image: radial-gradient(#DCE8EF 1px, transparent 1px);
            background-size: 20px 20px;
            color: #344A57;
        }
        .code-font { font-family: 'JetBrains Mono', monospace; }
        
        .wood-panel {
            background: linear-gradient(145deg, #DDEAF2, #F7F9FA);
            border: 2px solid #A7B9C4;
            box-shadow: 0 8px 20px rgba(0,0,0,0.4), inset 0 1px 1px rgba(255,255,255,0.1);
        }
        
        .soil-panel {
            background: #FFFFFF;
            border: 2px solid #DDEAF2;
            box-shadow: inset 0 4px 12px rgba(0,0,0,0.6);
        }

        .sky-panel {
            background: linear-gradient(180deg, #DDEAF2 0%, #F5F7F8 100%);
            border: 2px solid #8EADC0;
        }

        .rain-panel {
            background: linear-gradient(180deg, #AFC9D8 0%, #607D94 100%) !important;
            border: 2px solid #789DB5 !important;
        }

        .elnino-panel {
            background: linear-gradient(180deg, #D5C4AE 0%, #E8DFD1 100%) !important;
            border: 2px solid #B5A28B !important;
        }

        .locked {
            opacity: 0.3;
            pointer-events: none;
            filter: grayscale(80%) blur(1px);
            transition: all 0.4s ease;
        }
        .unlocked {
            opacity: 1;
            pointer-events: auto;
            filter: blur(0);
        }


        /* 3D Hierarchical Seed Tree
           Only the existing hierarchy panel uses these styles. */
        .seed-tree-3d {
            padding: 10px 8px 9px;
            overflow: hidden;
            background:
                radial-gradient(circle at 50% 20%, rgba(109, 76, 65, 0.22), transparent 42%),
                linear-gradient(180deg, #120b08 0%, #1a0f0b 58%, #100806 100%);
            border-color: #DDEAF2;
        }

        .seed-tree-scene {
            position: relative;
            min-height: 335px;
            perspective: 900px;
            transform-style: preserve-3d;
        }

        .seed-tree-root-wrap {
            position: relative;
            z-index: 5;
            display: flex;
            justify-content: center;
            padding-top: 4px;
        }

        .seed-tree-node,
        .seed-tree-category-node {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            box-sizing: border-box;
            border-radius: 11px;
            font-weight: 800;
            white-space: nowrap;
            transform-style: preserve-3d;
            text-shadow: 0 1px 2px rgba(0,0,0,.8);
        }

        .seed-tree-root {
            width: 92px;
            min-height: 58px;
            flex-direction: column;
            gap: 1px;
            padding: 6px 8px;
            color: #fff7ed;
            font-size: 12px;
            background: linear-gradient(145deg, #a76ee8 0%, #60319a 72%, #43236e 100%);
            border: 1px solid #d5a9ff;
            box-shadow:
                0 5px 0 #32194f,
                0 9px 15px rgba(0,0,0,.45),
                inset 0 1px 1px rgba(255,255,255,.35);
            transform: rotateX(7deg) translateZ(18px);
        }

        .seed-tree-root::after {
            content: "";
            position: absolute;
            left: 8px;
            right: -6px;
            bottom: -5px;
            height: 8px;
            border-radius: 0 0 8px 8px;
            background: #3b205f;
            transform: translateZ(-7px) skewX(-25deg);
            opacity: .9;
        }

        .seed-tree-icon {
            font-size: 13px;
            line-height: 1;
        }

        .seed-tree-name {
            line-height: 1.05;
        }

        .seed-tree-level {
            font-size: 7px;
            letter-spacing: .08em;
            color: #ead7ff;
            font-weight: 700;
        }

        .seed-tree-trunk {
            position: absolute;
            z-index: 2;
            top: 62px;
            left: 50%;
            width: 2px;
            height: 19px;
            background: linear-gradient(#b982e9, #8b5bb7);
            box-shadow: 0 0 5px rgba(185,130,233,.35);
        }

        .seed-tree-trunk::after {
            content: "";
            position: absolute;
            left: 50%;
            top: 18px;
            width: calc(100% - 16px);
            min-width: 210px;
            max-width: 270px;
            height: 2px;
            background: #8f623e;
            transform: translateX(-50%);
            box-shadow: 0 1px 0 rgba(255,255,255,.06);
        }

        .seed-tree-branches {
            position: relative;
            z-index: 3;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            padding: 27px 2px 0;
        }

        .seed-tree-category {
            position: relative;
            min-width: 0;
        }

        .seed-tree-category::before {
            content: "";
            position: absolute;
            top: -27px;
            left: 50%;
            height: 27px;
            width: 2px;
            background: #8f623e;
            box-shadow: 0 0 4px rgba(143,98,62,.35);
        }

        .seed-tree-category-node {
            min-height: 36px;
            padding: 6px 4px;
            color: #fff7ed;
            font-size: 10px;
            border: 1px solid;
            box-shadow:
                0 4px 0 rgba(0,0,0,.42),
                0 8px 12px rgba(0,0,0,.34),
                inset 0 1px 1px rgba(255,255,255,.25);
            transform: rotateX(8deg) translateZ(10px);
        }

        .flowers .seed-tree-category-node {
            background: linear-gradient(145deg, #c13b78, #741c4d);
            border-color: #dc6298;
        }

        .vegetables .seed-tree-category-node {
            background: linear-gradient(145deg, #5e9d2e, #326c16);
            border-color: #83c65a;
        }

        .fruits .seed-tree-category-node {
            background: linear-gradient(145deg, #d87821, #91470f);
            border-color: #ef9a43;
        }

        .seed-tree-category-stem {
            position: relative;
            width: 2px;
            height: 12px;
            margin: 0 auto;
            background: #8f623e;
        }

        .seed-tree-category-stem::after {
            content: "";
            position: absolute;
            top: 11px;
            left: 50%;
            width: calc(100% + 24px);
            min-width: 54px;
            max-width: 78px;
            height: 2px;
            background: #8f623e;
            transform: translateX(-50%);
        }

        .seed-tree-seeds {
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 7px;
            padding: 9px 1px 0;
        }

        .seed-tree-seeds::before {
            content: "";
            position: absolute;
            top: 9px;
            bottom: 17px;
            left: 50%;
            width: 2px;
            background: linear-gradient(#8f623e, rgba(143,98,62,.42));
            transform: translateX(-50%);
            z-index: 0;
        }

        .seed-tree-leaf {
            z-index: 1;
            min-height: 29px;
            padding: 5px 4px;
            color: #f7e9df;
            font-size: 9px;
            background: linear-gradient(145deg, #594036 0%, #33231d 72%, #271914 100%);
            border: 1px solid #896c5c;
            box-shadow:
                0 3px 0 #1d120e,
                0 6px 9px rgba(0,0,0,.3),
                inset 0 1px 1px rgba(255,255,255,.14);
            transform: perspective(500px) rotateX(5deg) translateZ(6px);
        }

        .seed-tree-leaf::before {
            content: "";
            position: absolute;
            left: 50%;
            top: -9px;
            width: 2px;
            height: 9px;
            background: #8f623e;
            transform: translateX(-50%);
        }

        .seed-tree-leaf::after {
            content: "";
            position: absolute;
            right: -4px;
            bottom: -3px;
            width: 100%;
            height: 100%;
            border-radius: 10px;
            background: rgba(52,35,29,.7);
            transform: translateZ(-5px) skewX(-10deg);
            z-index: -1;
        }

        .seed-tree-legend {
            position: relative;
            margin-top: 10px;
            text-align: center;
            color: #c98b35;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: .03em;
        }

        @media (max-width: 420px) {
            .seed-tree-scene { min-height: 320px; }
            .seed-tree-root { width: 82px; }
            .seed-tree-category-node { font-size: 9px; }
            .seed-tree-leaf { font-size: 8px; }
            .seed-tree-branches { gap: 5px; }
        }

        /* Planting & Growth Process — simple hierarchical tree visual */
        .growth-process {
            padding: 8px 2px 4px;
            overflow: hidden;
        }
        .growth-tree {
            display:flex; flex-direction:column; align-items:center;
            width:100%; position:relative;
        }
        .growth-level {
            display:flex; justify-content:center; align-items:flex-start;
            gap:7px; width:100%; position:relative;
        }
        .growth-level.single { gap:0; }
        .growth-connector-v {
            width:2px; height:10px; background:#A7B9C4; margin:0 auto;
        }
        .growth-children-connector {
            width:100%; height:10px; position:relative;
        }
        .growth-children-connector::before {
            content:""; position:absolute; left:16%; right:16%; top:0;
            height:1px; background:#A7B9C4;
        }
        .growth-children-connector.two::before { left:25%; right:25%; }
        .growth-children-connector.three::before { left:16%; right:16%; }
        .growth-child {
            flex:0 1 auto; min-width:0; display:flex; flex-direction:column;
            align-items:center; position:relative;
        }
        .growth-child::before {
            content:""; width:2px; height:10px; background:#A7B9C4;
            margin-top:-1px;
        }
        .growth-node {
            position:relative; width:60px; min-height:55px; padding:5px 3px;
            border:1px solid #A7B9C4; border-radius:10px;
            background:linear-gradient(145deg,#DDEAF2,#F7F9FA);
            box-shadow:0 4px 0 #C5D4DC,0 7px 12px rgba(0,0,0,.25),inset 0 1px rgba(255,255,255,.12);
            transform:rotateX(7deg) rotateY(-4deg); transition:.25s ease;
            text-align:center; z-index:2;
        }
        .growth-node.active {
            transform:translateY(-3px) rotateX(7deg) rotateY(-4deg);
            border-color:#789DB5;
            box-shadow:0 4px 0 #607D94,0 9px 16px rgba(245,158,11,.2),inset 0 1px rgba(255,255,255,.18);
        }
        .growth-node.done { opacity:.8; }
        .growth-icon { font-size:18px; line-height:1; }
        .growth-label { margin-top:3px; font-size:7px; font-weight:800; color:#40515C; line-height:1.1; }
        .growth-step { font-size:6px; color:#718590; margin-top:2px; }
        @media (max-width:760px) {
            .growth-level { gap:4px; }
            .growth-node { width:52px; min-height:50px; padding:4px 2px; }
            .growth-icon { font-size:15px; }
            .growth-label { font-size:6px; }
        }

        /* Seed Tree Traversal */
        .traversal-panel { width:100%; }
        .traversal-tree { overflow:hidden; padding:14px 8px 8px; perspective:900px; }
        .tr-level { display:flex; justify-content:center; align-items:flex-start; width:100%; position:relative; transform:scale(.82); transform-origin:top center; margin-bottom:-48px; }
        .tr-branch { display:flex; flex-direction:column; align-items:center; position:relative; min-width:0; }
        .tr-node {
            display:inline-flex; flex-direction:column; align-items:center; justify-content:center;
            min-width:68px; min-height:42px; max-width:96px; padding:6px 6px; border-radius:11px;
            background:linear-gradient(145deg,#DDEAF2,#302018); border:1px solid #A7B9C4;
            box-shadow:0 5px 0 #C5D4DC, 0 8px 14px rgba(0,0,0,.2); color:#40515C;
            font-size:8px; font-weight:800; transition:.25s ease; position:relative;
            transform:rotateX(5deg) rotateY(-3deg);
        }
        .tr-node small { color:#718590; font-size:6.5px; font-weight:600; margin-top:2px; }
        .tr-node.visited { border-color:#789DB5; background:linear-gradient(145deg,#6B472F,#3B261B); transform:translateY(-4px) rotateX(5deg) rotateY(-3deg); box-shadow:0 5px 0 #6B3F12, 0 10px 18px rgba(245,158,11,.2); }
        .tr-node.current { outline:2px solid #40515C; }
        .tr-children { display:flex; gap:6px; padding-top:18px; position:relative; }
        .tr-children::before { content:""; position:absolute; top:8px; left:7%; right:7%; height:1px; background:#A7B9C4; }
        .tr-children > .tr-branch::before { content:""; position:absolute; top:8px; width:1px; height:10px; background:#A7B9C4; }
        .tr-connector { width:1px; height:15px; background:#A7B9C4; }
        .tr-seq { min-height:30px; background:#F5F7F8; border:1px solid #DDEAF2; border-radius:10px; padding:7px 9px; font-family:'JetBrains Mono',monospace; font-size:9px; color:#D7CCC8; }
        .tr-seq strong { color:#789DB5; }
        .tr-help { font-size:9px; line-height:1.35; color:#C7B8B2; }
        @media (max-width: 760px) {
            .growth-process .growth-arrow { display:none; }
            .growth-process { display:grid !important; grid-template-columns:repeat(2,minmax(0,1fr)); }
            .growth-stage { min-width:0; }
        }
    

        /* Global minimalist white + powder-blue UI palette */
        body { background-color:#F5F7F8 !important; background-image:radial-gradient(#DCE8EF 1px,transparent 1px) !important; color:#344A57 !important; }
        .wood-panel { background:linear-gradient(145deg,#FFFFFF,#F1F5F7) !important; border-color:#A7B9C4 !important; box-shadow:0 8px 20px rgba(64,81,92,.12),inset 0 1px 1px rgba(255,255,255,.9) !important; }
        .soil-panel { background:#F7F9FA !important; border-color:#A7B9C4 !important; box-shadow:inset 0 4px 12px rgba(64,81,92,.08) !important; }
        .sky-panel { background:linear-gradient(180deg,#DDEAF2 0%,#FFFFFF 100%) !important; border-color:#8EADC0 !important; }
        .rain-panel { background:linear-gradient(180deg,#DCE8EF 0%,#AFC9D8 100%) !important; border-color:#789DB5 !important; }
        .elnino-panel { background:linear-gradient(180deg,#E8DFD1 0%,#F7F4EE 100%) !important; border-color:#B5A28B !important; }
        .text-amber-100,.text-amber-200,.text-amber-300,.text-amber-400,.text-amber-500,.text-amber-600,.text-amber-700,.text-amber-800,.text-amber-900 { color:#40515C !important; }
        .text-green-300,.text-green-400,.text-green-500,.text-green-600,.text-green-700,.text-green-800 { color:#607D94 !important; }
        .text-red-300,.text-red-400,.text-red-500,.text-red-600,.text-red-700 { color:#789DB5 !important; }
        .border-\[\#5D4037\],.border-\[\#6D4C41\],.border-\[\#4A3228\] { border-color:#A7B9C4 !important; }
        .bg-\[\#1A100C\],.bg-\[\#231612\],.bg-\[\#2D1E18\],.bg-\[\#36241C\],.bg-\[\#4A3228\] { background-color:#F7F9FA !important; }
        .seed-tree-root { background:linear-gradient(145deg,#BDD5E3,#8EADC0) !important; border-color:#789DB5 !important; color:#344A57 !important; box-shadow:0 5px 0 #607D94,0 9px 15px rgba(64,81,92,.16),inset 0 1px 1px rgba(255,255,255,.8) !important; }
        .seed-tree-category-node,.seed-tree-leaf { background:linear-gradient(145deg,#DDEAF2,#F7F9FA) !important; border-color:#A7B9C4 !important; color:#40515C !important; box-shadow:0 4px 0 #C5D4DC,0 8px 12px rgba(64,81,92,.12),inset 0 1px 1px rgba(255,255,255,.8) !important; }
        .seed-tree-3d { background:linear-gradient(180deg,#FFFFFF 0%,#F1F5F7 100%) !important; border-color:#A7B9C4 !important; }
        .seed-tree-trunk,.seed-tree-category::before,.seed-tree-category-stem,.seed-tree-seeds::before,.seed-tree-leaf::before,.seed-tree-trunk::after,.seed-tree-category-stem::after,.tr-children::before,.tr-children > .tr-branch::before,.tr-connector { background:#A7B9C4 !important; }
        .growth-process { background:#F5F5F1 !important; }
        .growth-node { background:#DDEAF2 !important; border-color:#A7B9C4 !important; color:#40515C !important; box-shadow:0 4px 0 #C5D4DC,0 7px 12px rgba(50,70,80,.12),inset 0 1px rgba(255,255,255,.7) !important; }
