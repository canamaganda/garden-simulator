    background: linear-gradient(145deg, #234B34, #173625) !important;
    border-color: #3E6B4A !important;
    box-shadow:
        0 8px 20px rgba(0,0,0,.38),
        inset 0 1px 1px rgba(255,255,255,.08) !important;
}

.soil-panel {
    background: linear-gradient(145deg, #3A2418, #26170F) !important;
    border-color: #69432B !important;
    box-shadow: inset 0 4px 12px rgba(0,0,0,.55) !important;
}

/* Strong blue sky/weather */
