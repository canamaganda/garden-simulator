        // Planting & Growth Process visual state — uses existing gameplay actions only.
        let growthState = "choose";
        function updateGrowthProcess(state, plantName="") {
            const order = ["buy","choose","plant","water","seedling","growing","mature","harvest"];
            const index = Math.max(0, order.indexOf(state));
            document.querySelectorAll(".growth-stage").forEach(el => {
                const key = el.dataset.growth;
                const i = order.indexOf(key);
                el.classList.toggle("active", key === state);
                el.classList.toggle("done", i < index);
            });
            const status = document.getElementById("growth-status");
            if (status) status.textContent = plantName ? `${plantName} — ${stateLabel(state)}` : stateLabel(state);
            growthState = state;
        }
        function stateLabel(state) {
            return ({buy:"Seed purchase step", choose:"Choose a seed from the Seed Bag", plant:"Seed planted in the garden", water:"Water the planted seed", seedling:"Seedling stage", growing:"Growing plant stage", mature:"Mature plant — ready to harvest", harvest:"Harvest completed"})[state] || "Choose a seed to begin.";
        }
        document.addEventListener("change", e => {
            if (e.target && e.target.id === "crop-selector" && e.target.value) updateGrowthProcess("choose", e.target.value);
        });

        // Seed hierarchy traversal demonstration.
        const seedTree = {
            name:"Seeds", children:[
                {name:"Flowers", children:[{name:"Tulip",children:[]},{name:"Cherry Blossom",children:[]},{name:"Sunflower",children:[]}]},
                {name:"Vegetables", children:[{name:"Tomato",children:[]},{name:"Onion",children:[]},{name:"Eggplant",children:[]}]},
                {name:"Fruits", children:[{name:"Strawberry",children:[]},{name:"Watermelon",children:[]},{name:"Mango",children:[]}]}
            ]
        };
        let traversalMode="bfs", traversalOrder=[], traversalIndex=-1, traversalTimer=null;
        function bfs(root){ const out=[], q=[root]; while(q.length){const n=q.shift(); out.push(n.name); n.children.forEach(c=>q.push(c));} return out; }
        function preorder(n,out=[]){ out.push(n.name); n.children.forEach(c=>preorder(c,out)); return out; }
        function inorder(n,out=[]){ if(!n.children.length){out.push(n.name);return out;} inorder(n.children[0],out); out.push(n.name); n.children.slice(1).forEach(c=>inorder(c,out)); return out; }
        function postorder(n,out=[]){ n.children.forEach(c=>postorder(c,out)); out.push(n.name); return out; }
        function setTraversal(mode){
            stopTraversal(); traversalMode=mode; traversalIndex=-1;
            traversalOrder = mode==="bfs" ? bfs(seedTree) : mode==="preorder" ? preorder(seedTree) : mode==="inorder" ? inorder(seedTree) : postorder(seedTree);
            document.querySelectorAll(".traversal-btn").forEach(b=>b.classList.remove("bg-amber-700","border-amber-500","text-amber-100"));
            const active=document.getElementById(`tr-btn-${mode}`); if(active) active.classList.add("bg-amber-700","border-amber-500","text-amber-100");
            resetTraversal(false);
            const label={bfs:"BFS",preorder:"DFS Preorder",inorder:"DFS Inorder",postorder:"DFS Postorder"}[mode];
            document.getElementById("traversal-sequence").innerHTML=`<strong>${label}:</strong> ${traversalOrder.join(" → ")}`;
        }
        function renderTraversalHighlight(){
            document.querySelectorAll("[data-tr-node]").forEach(n=>{n.classList.remove("visited","current"); const pos=traversalOrder.indexOf(n.dataset.trNode); if(pos!==-1 && pos<=traversalIndex)n.classList.add("visited"); if(pos===traversalIndex)n.classList.add("current");});
            const current=traversalOrder[traversalIndex]; document.getElementById("traversal-current").innerHTML=current?`<strong>Current:</strong> Visit #${traversalIndex+1} — ${current}`:`<strong>Current:</strong> Ready to traverse`;
        }
        function traversalNext(){ if(traversalIndex<traversalOrder.length-1){traversalIndex++;renderTraversalHighlight();} else stopTraversal(); }
        function toggleTraversalPlay(){ if(traversalTimer){stopTraversal();return;} const btn=document.getElementById("tr-play-btn"); btn.textContent="⏸ Pause"; traversalTimer=setInterval(()=>{if(traversalIndex>=traversalOrder.length-1){stopTraversal();return;} traversalNext();},850); }
        function stopTraversal(){ if(traversalTimer){clearInterval(traversalTimer);traversalTimer=null;} const btn=document.getElementById("tr-play-btn"); if(btn) btn.textContent="▶ Play"; }
        function resetTraversal(showReady=true){ stopTraversal(); traversalIndex=-1; renderTraversalHighlight(); if(showReady) document.getElementById("traversal-sequence").innerHTML=`<strong>${traversalMode.toUpperCase()}:</strong> ${traversalOrder.join(" → ")}`; }
        function initTraversal(){ setTraversal("bfs"); }

        function loadTopic() {
            const key = document.getElementById("topic-selector").value;
            document.getElementById("code-editor").value = savedCode[key] || topicTemplates[key].code;
        }

        function switchTab(tab) {
            document.getElementById("view-game").classList.toggle("hidden", tab !== "game");
            document.getElementById("view-code").classList.toggle("hidden", tab !== "code");
            document.getElementById("tab-game").classList.toggle("bg-[#4A3228]", tab === "game");
            document.getElementById("tab-code").classList.toggle("bg-[#4A3228]", tab === "code");
        }

        window.onload = () => {
            lucide.createIcons();
            renderGarden();
            renderClimateQueue();
            renderActionStack();
            updateResources();
            initTraversal();
            updateGrowthProcess("choose");
      
            const select = document.getElementById("topic-selector");
            Object.keys(topicTemplates).forEach(k => {
                let opt = document.createElement("option");
                opt.value = k;
                opt.textContent = topicTemplates[k].title;
                select.appendChild(opt);
            });
            loadTopic();
            switchTab('game');
        };
    </script>
